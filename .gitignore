# Backups created by install.ps1
*.bak-*

# Local scratch
*.log
*.tmp
Thumbs.db
.DS_Store

# Shim catalogue cache -- generated by install.ps1 (or --build-catalog),
# stale as soon as the upstream skill changes. Never commit it.
mcp-shim/sw_catalog.json

# npm / packaging
node_modules/
package-lock.json
pnpm-lock.yaml
*.tgz

# Python bytecode -- py_compile in CI writes these, and they must never ship
__pycache__/
*.pyc
*.pyo
